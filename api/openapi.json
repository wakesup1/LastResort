{
  "openapi": "3.0.3",
  "info": {
    "title": "LastResort API",
    "version": "0.1.0",
    "description": "S1-12 contract. Health, event details, guest sessions, atomic booking and ownership-safe reservation details are implemented. Operations marked planned are design contracts for subsequent tasks, not live endpoints. JSON uses camelCase and date-times include a timezone. The server decides sale windows, inventory and ownership. Guest sessions use a 30-day HttpOnly, SameSite=Lax cookie; it is Secure over HTTPS. Only a SHA-256 token hash is stored. Error messages contain no stack traces, credentials or session tokens."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/booking-operations/{operationKey}": {
      "get": {
        "operationId": "getBookingOperation",
        "summary": "Check the original booking outcome without resubmitting",
        "description": "S2-06: read only, scoped to the valid original guest cookie and UUID operation key. Returns the persisted outcome, including the original reservation snapshot or terminal business rejection. Never creates a session, operation or reservation and never changes inventory. Recovery works after sale closure or sell-out. Unknown, uncommitted and cross-owner operations share the same 404; absence does not prove failure and must not trigger a new booking. Retain the original operation across unavailable responses and reloads. No query parameters. Clearing or replacing guest cookies cannot recover the original owner.",
        "x-implementation": "implemented",
        "security": [
          {
            "guestSessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "operationKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "7b013fc7-c29f-428e-98ea-04cbe234e917"
          }
        ],
        "responses": {
          "200": {
            "description": "The original persisted booking outcome, not a new booking.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOperationResult"
                },
                "example": {
                  "eventId": "live-sessions-demo",
                  "outcome": {
                    "reservation": {
                      "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                      "status": "confirmed",
                      "quantity": 1,
                      "createdAt": "2026-10-20T10:00:00Z",
                      "event": {
                        "eventId": "live-sessions-demo",
                        "name": "Live Sessions (Demo)",
                        "startsAt": "2026-11-21T12:00:00Z",
                        "venue": "Demo Hall",
                        "ticketType": "General admission"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "description": "No completed operation visible to this session. Outcome remains unknown.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "No completed operation is available for this session. The booking outcome remains unknown."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Checking failed. Keep the original operation and retry this read.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The booking outcome could not be loaded. Try checking it again."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "post": {
        "operationId": "createOrResumeGuestSession",
        "summary": "Create or resume this browser's guest session",
        "description": "Implemented for S1-10. Same-origin POST with no request body. Creates a new server-side owner when the cookie is missing, invalid, or expired; otherwise it keeps the current owner. The opaque token is only sent in the HttpOnly lastresort_guest cookie and its SHA-256 hash is stored. The session expires 30 days after creation. No owner or token is accepted from or returned to JSON.",
        "x-implementation": "implemented",
        "responses": {
          "204": {
            "description": "The guest session is ready. Set-Cookie is included only when a new session was created.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": { "type": "string", "enum": ["no-store"] }
              },
              "Set-Cookie": {
                "description": "Opaque guest session cookie. HttpOnly, SameSite=Lax, Path=/, Max-Age=2592000; Secure is set over HTTPS.",
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/OriginForbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check database readiness",
        "description": "No query parameters are accepted. Readiness probe checks required booking/session/event/operation tables and columns with one database query. Empty inventory is healthy; missing booking schema or failed connectivity returns 503. Responses retain the established readiness JSON, no-store and a server-generated X-Request-Id. Structured logs record status, outcome and duration without credentials or database errors.",
        "x-implementation": "implemented",
        "responses": {
          "200": {
            "description": "Database and events table are reachable.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                },
                "example": {
                  "status": "ok",
                  "database": "ready"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "description": "Database or schema is unavailable.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                },
                "example": {
                  "status": "unavailable",
                  "database": "unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "operationId": "getEvent",
        "summary": "Read event details and sale status",
        "description": "Implemented for S1-08/S1-09. Invalid event IDs and query parameters return 400; unknown events return 404. Sale status uses server time; opening is inclusive and closing is exclusive. Check the sale window before inventory. Displayed remaining inventory does not reserve a ticket. Remaining must not exceed capacity.",
        "x-implementation": "implemented",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event details.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                },
                "example": {
                  "eventId": "live-sessions-demo",
                  "name": "Live Sessions (Demo)",
                  "startsAt": "2026-11-21T12:00:00Z",
                  "venue": "Demo Hall",
                  "ticketType": "General admission",
                  "priceMinor": 0,
                  "saleOpensAt": "2026-10-01T00:00:00Z",
                  "saleClosesAt": "2026-11-21T11:00:00Z",
                  "saleStatus": "open",
                  "capacity": 100,
                  "remaining": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/reservations": {
      "get": {
        "operationId": "listReservations",
        "summary": "List this guest session’s confirmed bookings",
        "description": "Implemented for S2-05. Read-only history derives ownership solely from the validated guest cookie. No session is created or renewed. Returns up to 20 confirmed bookings ordered by createdAt descending, then reference ascending. Use nextCursor as before to load older entries; an unknown or other-owner cursor returns the same 404. Retries of an operation appear only once. No owner selector or other query parameters are accepted. Missing, invalid or expired sessions return 401; a valid new session returns an empty list. All responses use no-store. Cookie loss or a different browser cannot recover earlier history.",
        "x-implementation": "implemented",
        "security": [
          {
            "guestSessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The last reservation reference from the preceding page, owned by this session."
          }
        ],
        "responses": {
          "200": {
            "description": "Owned confirmed bookings, or an empty list for a valid session with no bookings.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationHistory"
                },
                "example": {
                  "reservations": [
                    {
                      "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                      "status": "confirmed",
                      "quantity": 1,
                      "createdAt": "2026-10-20T10:00:00Z",
                      "event": {
                        "eventId": "live-sessions-demo",
                        "name": "Live Sessions (Demo)",
                        "startsAt": "2026-11-21T12:00:00Z",
                        "venue": "Demo Hall",
                        "ticketType": "General admission"
                      }
                    }
                  ],
                  "nextCursor": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "operationId": "createReservation",
        "summary": "Confirm one ticket",
        "description": "Same-origin requests only. Establish a guest session first with POST /api/session. Owner identity comes only from the validated cookie. Requires a UUID Idempotency-Key and exactly eventId and quantity: 1 in JSON (maximum 1024 bytes), without query parameters. Keys are scoped to the guest owner and are retained without automatic expiry/reuse. The normalized payload is the exact validated eventId and integer quantity 1; JSON whitespace/property order and UUID letter case do not change the operation. Concurrent same-owner/key requests wait on a database uniqueness constraint; a statement timeout returns 503 and remains retryable with the same key and original session. A first successful commit returns 201, a successful replay returns 200 with the original persisted result before checking current inventory or sale windows. NOT_FOUND, SALES_NOT_OPEN, SALES_CLOSED and SOLD_OUT are persisted terminal business results and replay with their original status/code. Same key with a different valid payload returns 409 OPERATION_CONFLICT. Invalid input, invalid sessions and uncommitted technical failures are not stored as terminal results. Another owner has an independent key scope and cannot read the original result. The browser saves and sends its operation key; unknown outcomes remain guarded until explicit recovery UI in S2-06. Never change keys to recover an unknown outcome.",
        "x-implementation": "implemented",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              },
              "example": {
                "eventId": "live-sessions-demo",
                "quantity": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A new confirmed one-ticket reservation, returned only after commit. Requires an established guest session; no cookie is created here.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                  "status": "confirmed",
                  "quantity": 1,
                  "createdAt": "2026-10-20T10:00:00Z",
                  "event": {
                    "eventId": "live-sessions-demo",
                    "name": "Live Sessions (Demo)",
                    "startsAt": "2026-11-21T12:00:00Z",
                    "venue": "Demo Hall",
                    "ticketType": "General admission"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/BookingConflict"
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Content-Type must be application/json."
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "The outcome may be unknown. Retry only the same key and payload with the original session. Technical failures that did not commit leave no operation or inventory writes.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The booking outcome could not be confirmed. Retry only the same operation key and payload with the original session."
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/OriginForbidden"
          },
          "200": {
            "description": "Original confirmed result replayed for the same guest owner, key and normalized payload; no additional inventory decrement.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-Id": {
                "description": "Server-generated request UUID for diagnostic correlation. Incoming request IDs are not trusted.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                  "status": "confirmed",
                  "quantity": 1,
                  "createdAt": "2026-10-20T10:00:00Z",
                  "event": {
                    "eventId": "live-sessions-demo",
                    "name": "Live Sessions (Demo)",
                    "startsAt": "2026-11-21T12:00:00Z",
                    "venue": "Demo Hall",
                    "ticketType": "General admission"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "guestSessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "7b013fc7-c29f-428e-98ea-04cbe234e917",
            "description": "One stable UUID per deliberate booking operation, scoped to the original guest session. Reuse only with the same payload."
          }
        ]
      }
    },
    "/api/reservations/{reference}": {
      "get": {
        "operationId": "getReservation",
        "summary": "Reopen an owned reservation",
        "description": "Implemented for S1-12. Invalid UUID references and query parameters return 400 before database access. Ownership comes only from the server-validated lastresort_guest cookie. Missing/invalid session returns 401. Unknown references and cross-owner references both return 404 without revealing whether the booking exists. Reading never creates a reservation. Clearing cookies or changing browsers does not recover old bookings.",
        "x-implementation": "implemented",
        "security": [{ "guestSessionCookie": [] }],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The existing confirmed booking for this session.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                  "status": "confirmed",
                  "quantity": 1,
                  "createdAt": "2026-10-20T10:00:00Z",
                  "event": {
                    "eventId": "live-sessions-demo",
                    "name": "Live Sessions (Demo)",
                    "startsAt": "2026-11-21T12:00:00Z",
                    "venue": "Demo Hall",
                    "ticketType": "General admission"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "guestSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lastresort_guest"
      }
    },
    "schemas": {
      "BookingOperationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "outcome"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reservation"
                ],
                "properties": {
                  "reservation": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "NOT_FOUND",
                      "SALES_NOT_OPEN",
                      "SALES_CLOSED",
                      "SOLD_OUT"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "HealthReady": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        }
      },
      "HealthUnavailable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "ORIGIN_FORBIDDEN",
                  "NOT_FOUND",
                  "SESSION_REQUIRED",
                  "SALES_NOT_OPEN",
                  "SALES_CLOSED",
                  "SOLD_OUT",
                  "OPERATION_CONFLICT",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "name",
          "startsAt",
          "venue",
          "ticketType"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "ticketType": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "name",
          "startsAt",
          "venue",
          "ticketType",
          "priceMinor",
          "saleOpensAt",
          "saleClosesAt",
          "saleStatus",
          "capacity",
          "remaining"
