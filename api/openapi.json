{
  "openapi": "3.0.3",
  "info": {
    "title": "LastResort API",
    "version": "0.1.0",
    "description": "S1-06/S1-10 contract. GET /api/health, GET /api/events/{eventId}, and POST /api/session are implemented. Operations marked planned are design contracts for subsequent tasks, not live endpoints. JSON uses camelCase and date-times include a timezone. The server decides sale windows, inventory and ownership. Guest sessions use a 30-day HttpOnly, SameSite=Lax cookie; it is Secure over HTTPS. Only a SHA-256 token hash is stored. Error messages contain no stack traces, credentials or session tokens."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/session": {
      "post": {
        "operationId": "createOrResumeGuestSession",
        "summary": "Create or resume this browser's guest session",
        "description": "Implemented for S1-10. Same-origin POST with no request body. Creates a new server-side owner when the cookie is missing, invalid, or expired; otherwise it keeps the current owner. The opaque token is only sent in the HttpOnly lastresort_guest cookie and its SHA-256 hash is stored. The session expires 30 days after creation. No owner or token is accepted from or returned to JSON.",
        "x-implementation": "implemented",
        "responses": {
          "204": {
            "description": "The guest session is ready. Set-Cookie is included only when a new session was created.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": { "type": "string", "enum": ["no-store"] }
              },
              "Set-Cookie": {
                "description": "Opaque guest session cookie. HttpOnly, SameSite=Lax, Path=/, Max-Age=2592000; Secure is set over HTTPS.",
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/OriginForbidden" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check database readiness",
        "description": "Implemented. No query parameters are accepted. Health 503 retains the S1-05 readiness shape instead of the general error envelope. Next.js also supplies HEAD/OPTIONS handling.",
        "x-implementation": "implemented",
        "responses": {
          "200": {
            "description": "Database and events table are reachable.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                },
                "example": {
                  "status": "ok",
                  "database": "ready"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "503": {
            "description": "Database or schema is unavailable.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                },
                "example": {
                  "status": "unavailable",
                  "database": "unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "operationId": "getEvent",
        "summary": "Read event details and sale status",
        "description": "Implemented for S1-08/S1-09. Invalid event IDs and query parameters return 400; unknown events return 404. Sale status uses server time; opening is inclusive and closing is exclusive. Check the sale window before inventory. Displayed remaining inventory does not reserve a ticket. Remaining must not exceed capacity.",
        "x-implementation": "implemented",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event details.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                },
                "example": {
                  "eventId": "live-sessions-demo",
                  "name": "Live Sessions (Demo)",
                  "startsAt": "2026-11-21T12:00:00Z",
                  "venue": "Demo Hall",
                  "ticketType": "General admission",
                  "priceMinor": 0,
                  "saleOpensAt": "2026-10-01T00:00:00Z",
                  "saleClosesAt": "2026-11-21T11:00:00Z",
                  "saleStatus": "open",
                  "capacity": 100,
                  "remaining": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/reservations": {
      "post": {
        "operationId": "createReservation",
        "summary": "Confirm one ticket",
        "description": "S1-11 atomic booking API. Establish a guest session first with POST /api/session; missing, invalid or expired sessions return 401. The owner comes only from the server-validated cookie. No owner/session data is accepted in JSON. Same-origin requests only. Accepts application/json with exactly eventId and quantity: 1, up to 1024 bytes, and no query parameters. A row lock and conditional update check database time after any lock wait; the reservation and inventory commit together before a 201 response. Each accepted POST is a new booking. Retry/idempotency support belongs to S2-03 and is not implemented: Idempotency-Key is currently rejected with 400 before database access. Do not retry an unknown outcome or expose the booking action in the UI before recovery is implemented. Reopening a result belongs to S1-12.",
        "x-implementation": "implemented",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              },
              "example": {
                "eventId": "live-sessions-demo",
                "quantity": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A new confirmed one-ticket reservation, returned only after commit. Requires an established guest session; no cookie is created here.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                  "status": "confirmed",
                  "quantity": 1,
                  "createdAt": "2026-10-20T10:00:00Z",
                  "event": {
                    "eventId": "live-sessions-demo",
                    "name": "Live Sessions (Demo)",
                    "startsAt": "2026-11-21T12:00:00Z",
                    "venue": "Demo Hall",
                    "ticketType": "General admission"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/BookingConflict"
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "Content-Type must be application/json."
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "The booking outcome could not be confirmed. A commit response may have been lost; do not submit another booking. Result discovery and retry support are future work.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "The booking outcome could not be confirmed. Do not submit another booking."
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "403": {
            "$ref": "#/components/responses/OriginForbidden"
          }
        },
        "x-planned-idempotency": "S2-03 will introduce a required owner-scoped Idempotency-Key UUID, persistent replay (200) and OPERATION_CONFLICT for a changed payload. Not accepted in S1-11.",
        "security": [
          {
            "guestSessionCookie": []
          }
        ]
      }
    },
    "/api/reservations/{reference}": {
      "get": {
        "operationId": "getReservation",
        "summary": "Reopen an owned reservation",
        "description": "Planned for S1-12. Ownership comes only from the server-validated lastresort_guest cookie. Missing/invalid session returns 401. Unknown references and cross-owner references both return 404 without revealing whether the booking exists. Reading never creates a reservation. Clearing cookies or changing browsers does not recover old bookings.",
        "x-implementation": "planned",
        "security": [{ "guestSessionCookie": [] }],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The existing confirmed booking for this session.",
            "headers": {
              "Cache-Control": {
                "description": "Responses are not cached.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "reference": "6bda9f21-c452-44fa-9468-f34f59159f31",
                  "status": "confirmed",
                  "quantity": 1,
                  "createdAt": "2026-10-20T10:00:00Z",
                  "event": {
                    "eventId": "live-sessions-demo",
                    "name": "Live Sessions (Demo)",
                    "startsAt": "2026-11-21T12:00:00Z",
                    "venue": "Demo Hall",
                    "ticketType": "General admission"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/SessionRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "guestSessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lastresort_guest"
      }
    },
    "schemas": {
      "HealthReady": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        }
      },
      "HealthUnavailable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "ORIGIN_FORBIDDEN",
                  "NOT_FOUND",
                  "SESSION_REQUIRED",
                  "SALES_NOT_OPEN",
                  "SALES_CLOSED",
                  "SOLD_OUT",
                  "OPERATION_CONFLICT",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "name",
          "startsAt",
          "venue",
          "ticketType"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "ticketType": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "name",
          "startsAt",
          "venue",
          "ticketType",
          "priceMinor",
          "saleOpensAt",
          "saleClosesAt",
          "saleStatus",
          "capacity",
          "remaining"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "ticketType": {
            "type": "string",
            "minLength": 1
          },
          "priceMinor": {
            "type": "integer",
            "enum": [
              0
            ]
          },
          "saleOpensAt": {
            "type": "string",
            "format": "date-time"
          },
          "saleClosesAt": {
            "type": "string",
            "format": "date-time"
          },
          "saleStatus": {
            "type": "string",
            "enum": [
              "not_open",
              "open",
              "closed",
              "sold_out"
            ]
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ReservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "quantity"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "quantity": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        }
      },
      "Reservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "status",
          "quantity",
          "createdAt",
          "event"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed"
            ]
          },
          "quantity": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "$ref": "#/components/schemas/EventSummary"
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "The request is invalid. Do not include owner/session fields in request data.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "INVALID_REQUEST",
                "message": "The request is invalid. Do not include owner/session fields in request data."
              }
            }
          }
        }
      },
      "OriginForbidden": {
        "description": "The request Origin does not match the API origin.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "ORIGIN_FORBIDDEN",
                "message": "This endpoint accepts same-origin requests only."
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The resource does not exist or does not belong to this session.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "The resource does not exist or does not belong to this session."
              }
            }
          }
        }
      },
      "SessionRequired": {
        "description": "A valid guest session is required.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "SESSION_REQUIRED",
                "message": "A valid guest session is required."
              }
            }
          }
        }
      },
      "Unavailable": {
        "description": "The service is temporarily unavailable. A booking outcome may still be unknown; retry the same operation.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "SERVICE_UNAVAILABLE",
                "message": "The service is temporarily unavailable. A booking outcome may still be unknown; retry the same operation."
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "The request could not be completed. No stack trace or internal details are returned.",
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "The request could not be completed. No stack trace or internal details are returned."
              }
            }
          }
        }
      },
      "BookingConflict": {
        "description": "SALES_NOT_OPEN, SALES_CLOSED, or SOLD_OUT. No entitlement is created and inventory is unchanged. OPERATION_CONFLICT and replay before current sale checks belong to S2-03.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "SOLD_OUT",
                "message": "No tickets are available."
              }
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "description": "Responses are not cached.",
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        }
      }
    }
  }
}
